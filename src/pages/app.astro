---
import Layout from '../layouts/Layout.astro';
import UploadForm from '../components/UploadForm.jsx';
---

<Layout title="VISUAILS - Transform Your Photo">
  <section class="app-section">
    <div class="container">
      <div class="app-header">
        <h1>Transform Your Photo</h1>
        <p>Upload any photo and generate multiple styles instantly with AI</p>
      </div>

      <UploadForm client:load />

      <div class="info-section">
        <h3>✨ What You Get</h3>
        <div class="info-grid">
          <div class="info-item">
            <div class="info-icon">📸</div>
            <h4>Catalog Style</h4>
            <p>Clean, professional product photography perfect for e-commerce</p>
          </div>
          <div class="info-item">
            <div class="info-icon">🎨</div>
            <h4>Lifestyle Style</h4>
            <p>Natural, lifestyle-focused images perfect for social media and marketing</p>
          </div>
          <div class="info-item">
            <div class="info-icon">🎭</div>
            <h4>Campaign Style</h4>
            <p>Bold, attention-grabbing campaign visuals for ads and promotions</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .app-section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    min-height: calc(100vh - 200px);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--spacing-lg);
  }

  .app-header {
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .app-header h1 {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    margin-bottom: var(--spacing-md);
  }

  .app-header p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
  }

  .info-section {
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-3xl);
    border-top: 1px solid var(--border-color);
  }

  .info-section h3 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-2xl);
  }

  .info-item {
    padding: var(--spacing-2xl);
    background: var(--brand-light);
    border-radius: 12px;
    text-align: center;
  }

  .info-icon {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-md);
  }

  .info-item h4 {
    margin-bottom: var(--spacing-md);
  }

  .info-item p {
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .app-section {
      padding: var(--spacing-2xl) var(--spacing-lg);
    }

    .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
