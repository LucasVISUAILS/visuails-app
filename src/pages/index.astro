---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import HomepageHero from '../components/HomepageHero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import SocialProof from '../components/SocialProof.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site } from '../data/site.js';

const title = 'AI Product Visuals for Ecommerce Brands — 48 Hours, 10x Cheaper';
const description =
  'VISUAILS generates studio-quality product visuals in 48 hours for 10x less than traditional photography. Catalog, lifestyle, and video—all optimized for sales.';
---

<Layout>
  <SEO slot="seo" title={title} description={description} path="/" />

  <!-- v5 Homepage Sections -->
  <HomepageHero />
  <ProblemSolution />
  <HowItWorks />
  <ServiceSelector />
  <SocialProof />
  <FinalCTA />
</Layout>
