---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import { services } from '../data/services.js';
import { areas } from '../data/areas.js';

const title = 'AI Product Visuals for Ecommerce Brands — Catalog, Lifestyle & Video';
const description =
  'VISUAILS turns your product photos into ecommerce-ready catalog images, lifestyle campaigns, and product videos with AI — up to 90% cheaper, 10x faster, 100% human-reviewed. From €19 per visual.';
---

<Layout>
  <SEO slot="seo" title={title} description={description} path="/" />

  <section class="hero container">
    <div class="hero-grid">
      <div>
        <h1><span class="gradient-text">Transform Photos</span> into Ecommerce Visuals with AI</h1>
        <p style="font-size:1.1rem;">
          Catalog images, lifestyle campaigns, and product video — generated from your existing
          product photos, human-reviewed before delivery, and ready in hours instead of weeks.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Start Free Sample — €0.99</a>
          <a href="/services/" class="btn btn-secondary">See Services</a>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img
          src="/images/visuails-catalog-images-ecommerce-product-photography-hero.webp"
          alt="AI-generated ecommerce catalog product photo with consistent studio lighting and clean background"
          width="720"
          height="720"
        />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>How It Works</h2>
        <p>Three steps between your raw product photo and a ready-to-publish visual.</p>
      </div>
      <div class="grid grid-3">
        <div class="card step-card">
          <div class="step-number">1</div>
          <h3>Upload Your Product</h3>
          <p>Send us your existing product photos — even phone shots work as a starting point.</p>
        </div>
        <div class="card step-card">
          <div class="step-number">2</div>
          <h3>AI Transforms</h3>
          <p>We generate catalog, lifestyle, or video visuals matched to your brief and brand.</p>
        </div>
        <div class="card step-card">
          <div class="step-number">3</div>
          <h3>Download & Use</h3>
          <p>Every visual is human-reviewed, then delivered ready for your storefront or ads.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Three Services, One Workflow</h2>
        <p>Pick a service below, or combine all three for a full product launch.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card">
            <h3>{s.name}</h3>
            <p>{s.shortDescription}</p>
            <p style="color:var(--brand-primary); font-weight:700;">From €{s.startingPrice} {s.priceUnit} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Areas We Serve</h2>
        <p>
          VISUAILS delivers fully digitally from our Enschede studio — no shoot location needed,
          which means no limit on which market we can serve. Here's where most of our current
          clients are based.
        </p>
      </div>
      <div class="pill-list" style="justify-content:center;">
        {areas.map((a) => (
          <a href={`/areas/${a.slug}/`} class="pill">{a.name}</a>
        ))}
      </div>
      <p class="text-center" style="margin-top:24px;">
        <a href="/areas/" class="btn btn-secondary">View All Areas</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Pricing</h2>
        <p>Start with a €0.99 sample, then pay per visual — no subscriptions required.</p>
      </div>
      <div class="grid grid-3">
        <div class="pricing-card">
          <h3>Test Sample</h3>
          <p class="price">€0.99</p>
          <p>One transformation, one per business — see the quality before you commit.</p>
        </div>
        <div class="pricing-card featured">
          <h3>Pay Per Visual</h3>
          <p class="price">€19<span> / visual</span></p>
          <p>10 visuals for €19 each. Mix catalog, lifestyle, or video however you need.</p>
        </div>
        <div class="pricing-card">
          <h3>Custom Plan</h3>
          <p class="price">Let's talk</p>
          <p>High-volume catalogs or ongoing campaign content — custom pricing available.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Ready to see your product transformed?</h2>
        <p>Start with a €0.99 sample — no subscription, no commitment.</p>
        <a href="/contact/" class="btn btn-primary">Start Free Sample</a>
      </div>
    </div>
  </section>
</Layout>
