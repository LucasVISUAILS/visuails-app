---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { getAllServices } from '../../lib/content.js';
import { site } from '../../data/site.js';

const services = await getAllServices();

const title = 'AI Ecommerce Visual Services — Catalog, Lifestyle & Video';
const description =
  'Explore VISUAILS\' three core services: AI catalog images, lifestyle campaign images, and product & campaign video — all human-reviewed, delivered in hours.';

const breadcrumbs = [
  { name: 'Home', url: site.url + '/' },
  { name: 'Services', url: site.url + '/services/' },
];
---

<Layout>
  <SEO slot="seo" title={title} description={description} path="/services/" />
  <BreadcrumbSchema slot="schema" items={breadcrumbs} />

  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span><span>Services</span>
  </nav>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1>AI Ecommerce Visual Services</h1>
        <p>{description}</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}/`} class="card">
            <img
              src={s.heroImage}
              alt={s.heroImageAlt}
              width="400"
              height="300"
              loading="lazy"
              style="border-radius:10px; margin-bottom:16px;"
            />
            <h2 style="font-size:1.3rem;">{s.name}</h2>
            <p>{s.tagline}</p>
            <p style="color:var(--brand-primary); font-weight:700;">From €{s.startingPrice} {s.priceUnit} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
