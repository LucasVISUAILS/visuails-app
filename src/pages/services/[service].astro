---
import Layout from '../../layouts/Layout.astro';
import SEO from '../../components/SEO.astro';
import ServiceSchema from '../../components/schema/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import { getAllServices, getServiceBySlug, getAllAreas } from '../../lib/content.js';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  const services = await getAllServices();
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const path = `/services/${service.slug}/`;
const pageUrl = site.url + path;
const areas = await getAllAreas();

const title = `${service.metaName} for Ecommerce — From €${service.startingPrice} | VISUAILS`;
const description = `${service.shortDescription} Human-reviewed, delivered in hours, from €${service.startingPrice} per visual.`;

const breadcrumbs = [
  { name: 'Home', url: site.url + '/' },
  { name: 'Services', url: site.url + '/services/' },
  { name: service.name, url: pageUrl },
];

const relatedServices = (
  await Promise.all(service.relatedServiceSlugs.map((slug) => getServiceBySlug(slug)))
).filter(Boolean);
---

<Layout>
  <SEO slot="seo" title={title} description={description} path={path} ogImage={service.heroImage} />
  <ServiceSchema slot="schema" service={service} pageUrl={pageUrl} />
  <BreadcrumbSchema slot="schema" items={breadcrumbs} />
  <FaqSchema slot="schema" faqs={service.faqs} />

  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span>
    <a href="/services/">Services</a><span class="sep">/</span>
    <span>{service.name}</span>
  </nav>

  <section class="hero container">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">VISUAILS Service</p>
        <h1>{service.metaName}</h1>
        <p style="font-size:1.1rem;">{service.tagline}</p>
        <p>{service.shortDescription}</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Start Free Sample — €0.99</a>
          <span class="pill">From €{service.startingPrice} {service.priceUnit}</span>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img src={service.heroImage} alt={service.heroImageAlt} width="720" height="720" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Why Brands Choose {service.name}</h2>
      </div>
      <div class="grid grid-4">
        {service.keyBenefits.map((b) => (
          <div class="card">
            <h3>{b.title}</h3>
            <p>{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Built For</h2>
      </div>
      <div class="pill-list" style="justify-content:center;">
        {service.useCases.map((u) => <span class="pill">{u}</span>)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>{service.name}, Available Wherever You Sell</h2>
        <p>
          {service.name} is delivered fully digitally, so there's no shoot location to book.
          Here's local context for the markets we serve most.
        </p>
      </div>
      <div class="grid grid-4">
        {areas.map((a) => (
          <a href={`/areas/${a.slug}/${service.slug}/`} class="link-card">
            <span>{service.name} in {a.name}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div style="max-width:760px; margin:0 auto;">
        {service.faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Related Services</h2>
      </div>
      <div class="grid grid-3">
        {relatedServices.map((s) => (
          <a href={`/services/${s.slug}/`} class="card">
            <h3>{s.name}</h3>
            <p>{s.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Try {service.name} for €0.99</h2>
        <p>See the quality on your own product before committing to a full batch.</p>
        <a href="/contact/" class="btn btn-primary">Start Free Sample</a>
      </div>
    </div>
  </section>
</Layout>
