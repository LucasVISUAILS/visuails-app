---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import { site } from '../data/site.js';

const title = 'Terms & Conditions';
const description = 'Terms and conditions for using VISUAILS services.';
---

<Layout>
  <SEO slot="seo" title={title} description={description} path="/terms/" noindex={true} />

  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span><span>Terms &amp; Conditions</span>
  </nav>

  <section class="section">
    <div class="container" style="max-width:760px;">
      <h1>Terms &amp; Conditions</h1>
      <p>
        <strong>Placeholder — replace before launch.</strong> This page is a structural placeholder
        so the footer link isn't broken. Replace this content with your actual terms of service,
        ideally drafted or reviewed by a legal professional, covering payment terms, revision
        policy, usage rights for delivered visuals, and liability.
      </p>
      <p>Contact: <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Layout>
