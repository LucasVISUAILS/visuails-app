---
import Layout from '../../../layouts/Layout.astro';
import SEO from '../../../components/SEO.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import BreadcrumbSchema from '../../../components/schema/BreadcrumbSchema.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { areas, getAreaBySlug } from '../../../data/areas.js';
import { services } from '../../../data/services.js';
import { site } from '../../../data/site.js';

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const path = `/areas/${area.slug}/`;
const pageUrl = site.url + path;

const title = `AI Product Visuals for Ecommerce Brands in ${area.name} | VISUAILS`;
const description = `Catalog images, lifestyle campaigns, and product video for ${area.name}-based ecommerce brands. Delivered digitally from VISUAILS' Enschede studio, human-reviewed, from €19 per visual.`;

const breadcrumbs = [
  { name: 'Home', url: site.url + '/' },
  { name: 'Areas We Serve', url: site.url + '/areas/' },
  { name: area.name, url: pageUrl },
];

const genericService = {
  metaName: `AI Product Visuals in ${area.name}`,
  name: `AI Product Visuals`,
  shortDescription: description,
  startingPrice: '19',
};

const otherAreas = areas.filter((a) => a.slug !== area.slug).slice(0, 4);
---

<Layout>
  <SEO slot="seo" title={title} description={description} path={path} />
  <ServiceSchema slot="schema" service={genericService} area={area} pageUrl={pageUrl} />
  <BreadcrumbSchema slot="schema" items={breadcrumbs} />

  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span>
    <a href="/areas/">Areas We Serve</a><span class="sep">/</span>
    <span>{area.name}</span>
  </nav>

  <section class="hero container">
    <div class="hero-grid">
      <div>
        <h1>AI Product Visuals for Ecommerce Brands in {area.name}</h1>
        <p style="font-size:1.1rem;">{area.marketContext}</p>
        <p><strong>Why remote production works for {area.shortName} brands:</strong> {area.whyRemoteWorks}</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Start Free Sample — €0.99</a>
        </div>
      </div>
      <MapEmbed query={area.mapQuery} label={area.name} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Services Available in {area.name}</h2>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/areas/${area.slug}/${s.slug}/`} class="card">
            <h3>{s.name} in {area.name}</h3>
            <p>{s.tagline}</p>
            <p style="color:var(--brand-primary); font-weight:700;">From €{s.startingPrice} {s.priceUnit} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 40px;">
        <div>
          <h2>Local Context</h2>
          <p>{area.localFact}</p>
        </div>
        <div>
          <h2>Industries We Work With in {area.name}</h2>
          <div class="pill-list">
            {area.industries.map((i) => <span class="pill">{i}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <h2>Other Areas We Serve</h2>
      </div>
      <div class="grid grid-4">
        {otherAreas.map((a) => (
          <a href={`/areas/${a.slug}/`} class="card">
            <h3>{a.name}</h3>
            <p>{a.marketContext}</p>
          </a>
        ))}
      </div>
      <p class="text-center" style="margin-top:24px;">
        <a href="/areas/" class="btn btn-secondary">View All Areas</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Bring Your {area.name} Products to Life</h2>
        <p>Start with a €0.99 sample — see the quality before you commit.</p>
        <a href="/contact/" class="btn btn-primary">Start Free Sample</a>
      </div>
    </div>
  </section>
</Layout>
