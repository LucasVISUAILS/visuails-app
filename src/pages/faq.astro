---
import Layout from '../layouts/Layout.astro';
import SEO from '../components/SEO.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../components/schema/FaqSchema.astro';
import { getAllServices, getAllAreas } from '../lib/content.js';
import { site } from '../data/site.js';

const services = await getAllServices();
const areas = await getAllAreas();

const title = 'FAQ — AI Product Visuals for Ecommerce';
const description =
  'Answers to common questions about VISUAILS: pricing, turnaround time, areas served, and how AI-generated catalog, lifestyle, and video visuals work.';

const generalFaqs = [
  {
    q: 'How does pricing work?',
    a: 'Start with a €0.99 test sample (one per business) to see the quality on your own product. After that, visuals are priced per unit starting from €19 — no subscription required. High-volume catalogs and ongoing campaigns can get custom pricing.',
  },
  {
    q: 'How fast is delivery?',
    a: 'Most orders are delivered within hours. Catalog batches placed before 3pm CET are typically same-day; larger lifestyle or video campaigns may take slightly longer depending on scope.',
  },
  {
    q: 'Which countries do you serve?',
    a: `Because delivery is fully digital, we work with ecommerce brands anywhere — most of our current clients are based in ${areas.map((a) => a.name).join(', ')}. See our Areas We Serve pages for market-specific detail.`,
  },
  {
    q: "What's the difference between this and stock photography?",
    a: 'Every image is generated specifically for your product using your own product photos as the source — nothing is pulled from a generic stock library, and every result is human-reviewed for accuracy before delivery.',
  },
  {
    q: 'Is there a subscription?',
    a: 'No. VISUAILS is pay-per-visual — you only pay for what you use, starting with a €0.99 sample.',
  },
  {
    q: 'How do I get started?',
    a: 'Send us a product photo through the Contact page and request your €0.99 test sample. From there we can scope a full catalog, lifestyle, or video batch.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: site.url + '/' },
  { name: 'FAQ', url: site.url + '/faq/' },
];
---

<Layout>
  <SEO slot="seo" title={title} description={description} path="/faq/" />
  <BreadcrumbSchema slot="schema" items={breadcrumbs} />
  <FaqSchema slot="schema" faqs={generalFaqs} />

  <nav class="breadcrumbs container" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span><span>FAQ</span>
  </nav>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h1>Frequently Asked Questions</h1>
      </div>
      <div style="max-width:760px; margin:0 auto 60px;">
        {generalFaqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      {services.map((s) => (
        <div style="max-width:760px; margin:0 auto 40px;">
          <h2>{s.name} Questions</h2>
          {s.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-band">
        <h2>Still have questions?</h2>
        <p>Reach out directly — we typically reply within one business day.</p>
        <a href="/contact/" class="btn btn-primary">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
