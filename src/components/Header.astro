---
import { services } from '../data/services.js';
import { areas } from '../data/areas.js';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">VISUAILS</a>

    <nav class="main-nav" aria-label="Main navigation">
      <ul>
        <li class="has-dropdown">
          <a href="/services/">Services</a>
          <ul class="dropdown">
            {services.map((s) => (
              <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </li>
        <li class="has-dropdown">
          <a href="/areas/">Areas We Serve</a>
          <ul class="dropdown">
            {areas.map((a) => (
              <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>
            ))}
          </ul>
        </li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <a href="/contact/" class="btn btn-primary header-cta">Get Started</a>

    <details class="mobile-menu">
      <summary aria-label="Open menu">☰</summary>
      <ul>
        <li><a href="/services/">Services</a></li>
        {services.map((s) => (
          <li class="indent"><a href={`/services/${s.slug}/`}>{s.name}</a></li>
        ))}
        <li><a href="/areas/">Areas We Serve</a></li>
        {areas.map((a) => (
          <li class="indent"><a href={`/areas/${a.slug}/`}>{a.name}</a></li>
        ))}
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </details>
  </div>
</header>
