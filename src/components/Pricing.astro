---
---

<section id="pricing" class="pricing-section">
  <div class="pricing-header">
    <h2>Simple Pricing</h2>
    <p>Choose the plan that fits your needs</p>
  </div>

  <div class="pricing-grid">
    <!-- Free Tier -->
    <div class="pricing-card">
      <div class="pricing-header-card">
        <h3>Test Sample</h3>
        <p class="price">€0.99</p>
        <p class="period">one-time</p>
      </div>
      <p class="description">Perfect to get started</p>
      <ul class="features">
        <li>✓ 1 Free Transform</li>
        <li>✓ All 3 Styles (Catalog, Lifestyle, Campaign)</li>
        <li>✓ High Resolution Download</li>
        <li>✓ No Credit Card Required</li>
      </ul>
      <a href="/app" class="btn btn-secondary">Try Free</a>
    </div>

    <!-- Pay Per Visual -->
    <div class="pricing-card featured">
      <div class="badge">Most Popular</div>
      <div class="pricing-header-card">
        <h3>Pay per Visual</h3>
        <p class="price">€19</p>
        <p class="period">per 10 visuals</p>
      </div>
      <p class="description">Scale as you grow</p>
      <ul class="features">
        <li>✓ Generate Up to 10 Visuals</li>
        <li>✓ All 3 Styles Included</li>
        <li>✓ 4K Resolution Downloads</li>
        <li>✓ Bulk Upload Support</li>
        <li>✓ 30-Day Access</li>
      </ul>
      <a href="/checkout?plan=pay-per" class="btn btn-primary">Get Started</a>
    </div>

    <!-- Custom -->
    <div class="pricing-card">
      <div class="pricing-header-card">
        <h3>Custom Plan</h3>
        <p class="price">Tailored</p>
        <p class="period">contact us</p>
      </div>
      <p class="description">For teams and enterprises</p>
      <ul class="features">
        <li>✓ Unlimited Transformations</li>
        <li>✓ Custom Style Training</li>
        <li>✓ API Access</li>
        <li>✓ Dedicated Support</li>
        <li>✓ Volume Discounts</li>
      </ul>
      <a href="/contact" class="btn btn-secondary">Contact Sales</a>
    </div>
  </div>

  <div class="pricing-faq">
    <h3>Questions?</h3>
    <p>All plans include unlimited downloads and re-use of generated images.</p>
  </div>
</section>

<style>
  .pricing-section {
    padding: var(--spacing-3xl) var(--spacing-lg);
    max-width: 1200px;
    margin: 0 auto;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .pricing-header h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-md);
  }

  .pricing-header p {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .pricing-card {
    background: var(--brand-white);
    border: 2px solid var(--border-color);
    border-radius: 16px;
    padding: var(--spacing-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    transition: all 0.3s ease;
    position: relative;
  }

  .pricing-card:hover {
    border-color: var(--brand-primary);
    box-shadow: 0 8px 24px rgba(0, 102, 255, 0.15);
  }

  .pricing-card.featured {
    border-color: var(--brand-primary);
    background: linear-gradient(135deg, rgba(0, 102, 255, 0.05) 0%, rgba(0, 212, 255, 0.05) 100%);
    transform: scale(1.05);
    box-shadow: 0 12px 32px rgba(0, 102, 255, 0.2);
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--brand-primary);
    color: var(--brand-white);
    padding: var(--spacing-xs) var(--spacing-lg);
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pricing-header-card {
    text-align: center;
  }

  .pricing-header-card h3 {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
  }

  .price {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--brand-primary);
    margin: 0;
  }

  .period {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    margin: var(--spacing-sm) 0 0;
  }

  .description {
    text-align: center;
    color: var(--text-secondary);
    font-size: var(--font-size-base);
  }

  .features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    flex-grow: 1;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    color: var(--text-primary);
    font-size: var(--font-size-base);
  }

  .pricing-card .btn {
    width: 100%;
    text-align: center;
  }

  .pricing-faq {
    text-align: center;
    padding: var(--spacing-2xl);
    background: var(--brand-light);
    border-radius: 12px;
  }

  .pricing-faq h3 {
    margin-bottom: var(--spacing-md);
  }

  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .pricing-card.featured {
      transform: scale(1);
    }
  }
</style>
