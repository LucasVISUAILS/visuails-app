---
---

<section class="hero">
  <div class="hero-content">
    <h1>Transform Photos with AI</h1>
    <p class="hero-subtitle">
      Convert your images into multiple styles instantly.
      From catalog photos to lifestyle content, all with one click.
    </p>
    <div class="hero-cta">
      <a href="/app" class="btn btn-primary btn-lg">Start Free</a>
      <a href="#pricing" class="btn btn-secondary btn-lg">See Pricing</a>
    </div>
  </div>

  <div class="hero-visual">
    <div class="before-after">
      <div class="before">
        <div class="image-placeholder">📷</div>
        <p>Your Photo</p>
      </div>
      <div class="arrow">→</div>
      <div class="after">
        <div class="outputs">
          <div class="output-badge catalog">Catalog</div>
          <div class="output-badge lifestyle">Lifestyle</div>
          <div class="output-badge campaign">Campaign</div>
        </div>
        <p>AI Transforms</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-3xl);
    align-items: center;
    padding: var(--spacing-3xl) var(--spacing-lg);
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-content h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--spacing-lg);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    margin-bottom: var(--spacing-2xl);
  }

  .hero-cta {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .btn-lg {
    padding: var(--spacing-md) var(--spacing-2xl);
    font-size: var(--font-size-lg);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .before-after {
    display: flex;
    align-items: center;
    gap: var(--spacing-2xl);
    padding: var(--spacing-2xl);
    background: var(--brand-light);
    border-radius: 16px;
  }

  .before, .after {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
  }

  .image-placeholder {
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, #ddd 0%, #999 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  .outputs {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .output-badge {
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-white);
    text-align: center;
  }

  .output-badge.catalog {
    background: linear-gradient(135deg, #0066ff 0%, #0052cc 100%);
  }

  .output-badge.lifestyle {
    background: linear-gradient(135deg, #00d4ff 0%, #00a8cc 100%);
  }

  .output-badge.campaign {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .arrow {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .before p, .after p {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: var(--spacing-2xl) var(--spacing-lg);
    }

    .before-after {
      flex-direction: column;
      gap: var(--spacing-lg);
    }
  }
</style>
