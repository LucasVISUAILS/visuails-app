---
// Service schema for a core service page or an area-service page.
// Pass `area` to scope areaServed to that specific country instead of
// the sitewide default — this is what gives each area-service page a
// distinct, honest local-relevance signal without a fake business entity.
import { site } from '../../data/site.js';

const { service, area = null, pageUrl } = Astro.props;

const areaServed = area
  ? { '@type': 'Country', name: area.name }
  : { '@type': 'Place', name: 'Anywhere digital delivery is possible' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.metaName,
  serviceType: service.name,
  description: service.shortDescription,
  provider: { '@id': `${site.url}/#organization` },
  areaServed,
  url: pageUrl,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: service.startingPrice,
    url: pageUrl,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
