---
// "See it in action" — click between result types to preview the output.
// Pure CSS (radio inputs + :has()), no client-side JS/hydration needed.
const tabs = [
  {
    id: 'tab-catalog',
    panel: 'panel-catalog',
    checked: true,
    title: 'Catalog Visuals',
    description: 'Clean, consistent product shots for your storefront and marketplaces.',
    image: '/images/visuails-demo-catalog.webp',
    alt: 'Example catalog visual generated by VISUAILS',
  },
  {
    id: 'tab-lifestyle',
    panel: 'panel-lifestyle',
    checked: false,
    title: 'Lifestyle Visuals',
    description: 'Your product in a real, styled scene with a consistent model.',
    image: '/images/visuails-demo-lifestyle.webp',
    alt: 'Example lifestyle visual generated by VISUAILS',
  },
  {
    id: 'tab-campaign',
    panel: 'panel-campaign',
    checked: false,
    title: 'Campaign Visuals',
    description: 'Ad-ready video and imagery built for paid social and product pages.',
    image: '/images/visuails-demo-campaign.webp',
    alt: 'Example campaign visual generated by VISUAILS',
  },
];
---

<div class="process-demo">
  <div class="process-tabs">
    {tabs.map((tab, i) => (
      <label class="process-tab-label">
        <input
          type="radio"
          name="process-tab"
          id={tab.id}
          class="process-tab-input"
          checked={tab.checked}
        />
        <strong>{i + 1}. {tab.title}</strong>
        <span>{tab.description}</span>
      </label>
    ))}
  </div>
  <div class="process-panels">
    {tabs.map((tab) => (
      <div class={`process-panel ${tab.panel}`}>
        <img src={tab.image} alt={tab.alt} loading="lazy" width="600" height="450" />
      </div>
    ))}
  </div>
</div>
