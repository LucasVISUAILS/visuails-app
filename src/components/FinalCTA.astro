---
// Final CTA Section - Before footer
import ROICalculator from './ROICalculator.astro';

const site = {
  whatsapp: {
    link: 'https://wa.me/31123456789?text=Hi%20VISUAILS%2C%20I%27m%20interested%20in%20your%20services'
  }
};
---

<section class="final-cta">
  <div class="container">
    <!-- ROI Calculator -->
    <ROICalculator />

    <!-- Contact CTA -->
    <div class="contact-section">
      <div class="contact-content">
        <h2>Ready to transform your product photography?</h2>
        <p>Start with a free test sample, or dive right in. We're here to help.</p>

        <div class="contact-ctas">
          <a href="/test-sample/" class="btn btn-primary">
            Free test sample — no credit card
          </a>

          <a href="/contact/" class="btn btn-secondary">
            Contact us
          </a>

          <a href={site.whatsapp.link} target="_blank" rel="noopener" class="btn btn-tertiary">
            WhatsApp chat
          </a>
        </div>

        <div class="support-info">
          <p>Live support · Mon–Fri 9–18 CET · Response time: <strong>under 1 hour</strong></p>
          <p>Email: hello@visuails.com</p>
          <p>Rated 4.9/5 from 48 reviews</p>
        </div>
      </div>

      <div class="stats-summary">
        <div class="summary-stat">
          <span class="summary-label">Average Time Saved</span>
          <span class="summary-value">90 days</span>
        </div>

        <div class="summary-stat">
          <span class="summary-label">Cost Reduction</span>
          <span class="summary-value">80%</span>
        </div>

        <div class="summary-stat">
          <span class="summary-label">Brands Active</span>
          <span class="summary-value">500+</span>
        </div>

        <div class="summary-stat">
          <span class="summary-label">Visuals Created</span>
          <span class="summary-value">2.5M+</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: 120px 0;
    background: #F8F9FA;
  }

  .contact-section {
    margin-top: 100px;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 72px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-content h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1.05;
    color: var(--text-primary);
    margin: 0;
  }

  .contact-content p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .contact-ctas {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .btn {
    padding: 14px 24px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-align: center;
    justify-content: center;
  }

  .btn-primary {
    background: var(--brand-primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--brand-primary-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 82, 204, 0.2);
  }

  .btn-secondary {
    background: var(--bg-raised);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover {
    border-color: var(--brand-primary);
    background: #FFFFFF;
  }

  .btn-tertiary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-tertiary:hover {
    border-color: var(--text-secondary);
    background: var(--bg-base);
  }

  .support-info {
    padding: 20px;
    background: #F8F9FA;
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--brand-primary);
  }

  .support-info p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0 0 8px 0;
  }

  .support-info p:last-child {
    margin: 0;
  }

  .support-info strong {
    color: var(--text-primary);
  }

  /* Stats Summary */
  .stats-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .summary-stat {
    background: linear-gradient(135deg, #F8F9FA, #F0F2F5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 20px;
    text-align: center;
    transition: all 0.2s ease;
  }

  .summary-stat:hover {
    border-color: var(--brand-primary);
    background: linear-gradient(135deg, #FFFFFF, #F8F9FA);
    box-shadow: 0 2px 8px rgba(0, 82, 204, 0.08);
  }

  .summary-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .summary-value {
    display: block;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--brand-primary);
  }

  @media (max-width: 1024px) {
    .contact-section {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .stats-summary {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .final-cta {
      padding: 60px 0;
    }

    .contact-section {
      padding: 32px;
      gap: 24px;
    }

    .contact-content h2 {
      font-size: 1.5rem;
    }

    .contact-content p {
      font-size: 1rem;
    }

    .btn {
      padding: 12px 16px;
      font-size: 13px;
    }

    .stats-summary {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .summary-value {
      font-size: 24px;
    }
  }
</style>
