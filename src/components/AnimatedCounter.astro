---
// Animated Counter - Numbers animate from 0 to final value on scroll into view
interface Props {
  label: string;
  value: number;
  suffix?: string;
  prefix?: string;
  duration?: number;
  icon?: string;
  className?: string;
}

const {
  label,
  value,
  suffix = '',
  prefix = '',
  duration = 2000,
  icon,
  className = '',
} = Astro.props;

const counterId = `counter-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={`stat-card ${className}`}>
  {icon && <span class="stat-icon">{icon}</span>}

  <div class="stat-value">
    <span class="stat-prefix">{prefix}</span>
    <span class="stat-number" data-counter-id={counterId} data-target={value}>
      0
    </span>
    <span class="stat-suffix">{suffix}</span>
  </div>

  <p class="stat-label">{label}</p>
</div>

<script define:vars={{ counterId, value, duration }}>
  function initializeCounter() {
    const counter = document.querySelector(`[data-counter-id="${counterId}"]`);
    if (!counter) return;

    let hasAnimated = false;

    function animateCounter() {
      if (hasAnimated) return;
      hasAnimated = true;

      const target = parseInt(counter.getAttribute('data-target'), 10);
      const increment = target / (duration / 16); // ~60fps
      let current = 0;

      const interval = setInterval(() => {
        current += increment;

        if (current >= target) {
          current = target;
          clearInterval(interval);
        }

        // Format with commas
        counter.textContent = Math.floor(current).toLocaleString();
      }, 16);
    }

    // Intersection Observer to trigger animation on scroll into view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter();
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(counter.closest('.stat-card'));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCounter);
  } else {
    initializeCounter();
  }
</script>

<style>
  .stat-card {
    text-align: center;
    padding: 20px 12px;
    background: transparent;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .stat-icon {
    display: none;
  }

  .stat-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
  }

  .stat-number {
    font-family: var(--font-display, Georgia, serif);
    font-size: 3rem;
    font-weight: 400;
    color: var(--text-primary, #1a202c);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stat-prefix,
  .stat-suffix {
    font-family: var(--font-display, Georgia, serif);
    font-size: 2rem;
    color: var(--brand-primary, #0052cc);
    font-weight: 400;
  }

  .stat-label {
    margin: 0;
    color: #718096;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .stat-card {
      padding: 16px 8px;
      gap: 6px;
    }

    .stat-number {
      font-size: 2.2rem;
    }

    .stat-prefix,
    .stat-suffix {
      font-size: 1.5rem;
    }

    .stat-label {
      font-size: 0.65rem;
    }
  }
</style>
