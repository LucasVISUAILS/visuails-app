---
// Animated Counter - Numbers animate from 0 to final value on scroll into view
interface Props {
  label: string;
  value: number;
  suffix?: string;
  prefix?: string;
  duration?: number;
  icon?: string;
  className?: string;
}

const {
  label,
  value,
  suffix = '',
  prefix = '',
  duration = 2000,
  icon,
  className = '',
} = Astro.props;

const counterId = `counter-${Math.random().toString(36).substr(2, 9)}`;
---

<div class={`stat-card ${className}`}>
  {icon && <span class="stat-icon">{icon}</span>}

  <div class="stat-value">
    <span class="stat-prefix">{prefix}</span>
    <span class="stat-number" data-counter-id={counterId} data-target={value}>
      0
    </span>
    <span class="stat-suffix">{suffix}</span>
  </div>

  <p class="stat-label">{label}</p>
</div>

<script define:vars={{ counterId, value, duration }}>
  function initializeCounter() {
    const counter = document.querySelector(`[data-counter-id="${counterId}"]`);
    if (!counter) return;

    let hasAnimated = false;

    function animateCounter() {
      if (hasAnimated) return;
      hasAnimated = true;

      const target = parseInt(counter.getAttribute('data-target'), 10);
      const increment = target / (duration / 16); // ~60fps
      let current = 0;

      const interval = setInterval(() => {
        current += increment;

        if (current >= target) {
          current = target;
          clearInterval(interval);
        }

        // Format with commas
        counter.textContent = Math.floor(current).toLocaleString();
      }, 16);
    }

    // Intersection Observer to trigger animation on scroll into view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter();
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(counter.closest('.stat-card'));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCounter);
  } else {
    initializeCounter();
  }
</script>

<style>
  .stat-card {
    text-align: center;
    padding: 24px;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .stat-card:hover {
    border-color: #0052cc;
    box-shadow: 0 4px 16px rgba(0, 82, 204, 0.1);
    transform: translateY(-2px);
  }

  .stat-icon {
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #f0f2f5;
    border-radius: 8px;
    margin-bottom: 8px;
  }

  .stat-value {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
  }

  .stat-number {
    font-size: 32px;
    font-weight: 700;
    color: #0052cc;
    font-variant-numeric: tabular-nums;
    letter-spacing: -1px;
  }

  .stat-prefix,
  .stat-suffix {
    font-size: 16px;
    color: #718096;
    font-weight: 500;
  }

  .stat-label {
    margin: 0;
    color: #718096;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .stat-card {
      padding: 16px;
      gap: 6px;
    }

    .stat-icon {
      width: 40px;
      height: 40px;
      font-size: 24px;
      margin-bottom: 4px;
    }

    .stat-number {
      font-size: 24px;
    }

    .stat-prefix,
    .stat-suffix {
      font-size: 14px;
    }

    .stat-label {
      font-size: 12px;
    }
  }
</style>
