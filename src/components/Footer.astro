---
import { getAllServices, getAllAreas } from '../lib/content.js';
import { site } from '../data/site.js';

const services = await getAllServices();
const areas = await getAllAreas();
const year = 2026;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="logo">VISUAILS</p>
      <p>{site.description}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>{site.address.locality}, The Netherlands</p>
    </div>

    <div class="footer-col">
      <h3>Services</h3>
      <ul>
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>Areas We Serve</h3>
      <ul>
        {areas.map((a) => (
          <li><a href={`/areas/${a.slug}/`}>{a.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>Company</h3>
      <ul>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms & Conditions</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} VISUAILS. All rights reserved.</p>
  </div>
</footer>
