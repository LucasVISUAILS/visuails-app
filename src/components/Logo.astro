---
// VISUAILS Logo Component - Blue V-Mark with leaf accent
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
  className?: string;
}

const { size = 'md', showText = false, className = '' } = Astro.props;

const sizes = {
  sm: { width: 32, height: 32 },
  md: { width: 48, height: 48 },
  lg: { width: 64, height: 64 },
};

const sizeConfig = sizes[size];
---

<div class={`logo-wrapper ${className}`}>
  <svg
    width={sizeConfig.width}
    height={sizeConfig.height}
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="logo-svg"
  >
    <!-- Main V shape -->
    <path
      d="M 25 30 L 50 85 L 75 30 Z"
      fill="#0052CC"
      stroke="#0052CC"
      stroke-width="2"
      stroke-linejoin="round"
    />

    <!-- Left leaf (rounded top) -->
    <path
      d="M 35 28 Q 30 28 28 35 Q 28 42 35 42 Q 40 42 42 35 Q 42 28 35 28 Z"
      fill="#0052CC"
    />

    <!-- Right leaf (rounded top) -->
    <path
      d="M 65 28 Q 72 28 74 35 Q 74 42 67 42 Q 60 42 58 35 Q 58 28 65 28 Z"
      fill="#0052CC"
    />
  </svg>

  {
    showText && (
      <span class="logo-text">
        VISUAILS
      </span>
    )
  }
</div>

<style>
  .logo-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-svg {
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 82, 204, 0.1));
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .logo-wrapper:hover .logo-svg {
    transform: scale(1.05);
    filter: drop-shadow(0 4px 12px rgba(0, 82, 204, 0.15));
  }

  .logo-text {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.5px;
    color: #1a202c;
    white-space: nowrap;
  }
</style>
