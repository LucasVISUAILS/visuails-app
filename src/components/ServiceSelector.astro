---
// Service Selector - 3 service cards with mood descriptors
import MoodDescriptor from './MoodDescriptor.astro';

const services = [
  {
    id: 'catalog',
    name: 'Catalog Visuals',
    description: 'Clean, consistent product shots for your storefront and marketplaces.',
    startingPrice: '€19',
    mood: 'Minimal & Professional',
    moodDesc: 'Clean, consistent, ready for marketplaces',
    keywords: ['Ecommerce', 'Clean', 'Professional'],
    highlights: ['All angles', 'Consistent lighting', 'Marketplace-ready'],
    image: '/images/visuails-catalog-hero.webp',
    link: '/catalog/',
  },
  {
    id: 'lifestyle',
    name: 'Lifestyle Visuals',
    description: 'Your product in real, styled scenes with consistent models.',
    startingPrice: '€35',
    mood: 'Lifestyle & Engaging',
    moodDesc: 'Real models, authentic vibes, conversion-focused',
    keywords: ['Authentic', 'Styled', 'Models'],
    highlights: ['Real models', 'Styled scenes', 'High conversion'],
    image: '/images/visuails-lifestyle-hero.webp',
    link: '/lifestyle/',
  },
  {
    id: 'video',
    name: 'Video Visuals',
    description: 'Ad-ready motion content built for paid social and product pages.',
    startingPrice: 'Custom',
    mood: 'Dynamic & Energetic',
    moodDesc: 'Motion graphics, trending, ad-ready',
    keywords: ['Motion', 'Trending', 'Ads'],
    highlights: ['Motion graphics', 'Ad-ready', 'Social-optimized'],
    image: '/images/visuails-video-hero.webp',
    link: '/video/',
  },
];
---

<section class="service-selector">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Choose Your Service</span>
      <h2>Which Visual Do You Need?</h2>
      <p>Each service is optimized for different platforms and goals.</p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <a href={service.link} class="service-card">
          <!-- Image -->
          <div class="service-image">
            <img
              src={service.image}
              alt={`${service.name} example`}
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="service-content">
            <h3 class="service-title">{service.name}</h3>
            <p class="service-desc">{service.description}</p>

            <!-- Mood Descriptor -->
            <div class="service-mood">
              <MoodDescriptor
                mood={service.mood}
                description={service.moodDesc}
                keywords={service.keywords}
              />
            </div>

            <!-- Highlights -->
            <ul class="service-highlights">
              {service.highlights.map((highlight) => (
                <li key={highlight}>{highlight}</li>
              ))}
            </ul>

            <!-- Price & CTA -->
            <div class="service-footer">
              <span class="service-price">from {service.startingPrice}/image</span>
              <span class="service-cta">Explore {service.name} →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-selector {
    padding: 120px 0;
    background: #F8F9FA;
  }

  .section-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-tertiary);
    margin-bottom: 20px;
  }

  .section-header h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    color: var(--text-primary);
    margin: 0 0 16px 0;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.15rem;
    margin: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .service-card {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    cursor: pointer;
  }

  .service-card:hover {
    border-color: var(--brand-primary);
    box-shadow: 0 8px 32px rgba(0, 82, 204, 0.12);
    transform: translateY(-8px);
  }

  .service-image {
    position: relative;
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: #F0F2F5;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-image img {
    transform: scale(1.05);
  }

  .service-content {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    flex: 1;
  }

  .service-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .service-desc {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .service-mood {
    padding: 12px;
    background: #F8F9FA;
    border-radius: var(--radius-sm);
  }

  .service-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-highlights li {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 6px 14px;
  }

  .service-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .service-price {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  .service-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand-primary);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .service-card:hover .service-cta {
    transform: translateX(2px);
  }

  .service-card:hover .service-cta {
    color: var(--brand-primary-light);
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .service-selector {
      padding: 60px 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .section-header h2 {
      font-size: 1.8rem;
    }

    .section-header p {
      font-size: 1rem;
    }

    .service-image {
      height: 200px;
    }

    .service-content {
      padding: 16px;
      gap: 12px;
    }

    .service-title {
      font-size: 1.1rem;
    }

    .service-desc {
      font-size: 13px;
    }
  }
</style>
