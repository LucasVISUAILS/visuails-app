---
// Social Proof Section with Animated Counters
import AnimatedCounter from './AnimatedCounter.astro';
---

<section class="social-proof">
  <div class="container">
    <div class="proof-header">
      <span class="eyebrow">Trusted by Leading Brands</span>
      <h2>Our Impact</h2>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <AnimatedCounter
        label="Brands Worldwide"
        value={500}
        suffix="+"
        duration={2000}
      />

      <AnimatedCounter
        label="Visuals Generated"
        value={2500000}
        prefix=""
        suffix="+"
        duration={2500}
      />

      <AnimatedCounter
        label="Average Delivery"
        value={48}
        suffix="h"
        duration={1500}
      />

      <AnimatedCounter
        label="Client Retention"
        value={95}
        suffix="%"
        duration={2000}
      />

      <AnimatedCounter
        label="ROI Lift (Avg)"
        value={70}
        suffix="%"
        duration={2000}
      />

      <AnimatedCounter
        label="Cost Savings"
        value={10}
        suffix="x"
        duration={2000}
      />
    </div>

    <!-- Trust Badges -->
    <div class="trust-section">
      <h3>Why brands choose VISUAILS</h3>
      <div class="trust-grid">
        <div class="trust-badge">
          <strong>Results-focused</strong>
          <p>Every visual optimized for conversion, not just aesthetics.</p>
        </div>

        <div class="trust-badge">
          <strong>AI-powered</strong>
          <p>Advanced AI that learns your brand and delivers consistency.</p>
        </div>

        <div class="trust-badge">
          <strong>Full control</strong>
          <p>Revision rounds included. Your feedback shapes the output.</p>
        </div>

        <div class="trust-badge">
          <strong>Scale instantly</strong>
          <p>Need 500 images? Get them in days, not months.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .social-proof {
    padding: 120px 0;
    background: #FFFFFF;
  }

  .proof-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-tertiary);
    margin-bottom: 20px;
  }

  .proof-header h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    color: var(--text-primary);
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
    margin-bottom: 100px;
  }

  /* Trust Section */
  .trust-section {
    padding-top: 80px;
    border-top: 1px solid var(--border-subtle);
  }

  .trust-section h3 {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.2rem;
    color: var(--text-primary);
    margin: 0 0 56px 0;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .trust-badge {
    padding: 4px 0;
    text-align: left;
    border-top: 1px solid var(--border-subtle);
    padding-top: 24px;
    transition: border-color 0.2s ease;
  }

  .trust-badge:hover {
    border-color: var(--brand-primary);
  }

  .trust-badge strong {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .trust-badge p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .social-proof {
      padding: 60px 0;
    }

    .proof-header h2 {
      font-size: 1.8rem;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 48px;
    }

    .trust-section {
      padding-top: 48px;
    }

    .trust-section h3 {
      font-size: 1.4rem;
      margin-bottom: 24px;
    }

    .trust-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .trust-badge {
      padding: 16px;
    }

    .badge-emoji {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .trust-badge strong {
      font-size: 13px;
    }

    .trust-badge p {
      font-size: 12px;
    }
  }
</style>
