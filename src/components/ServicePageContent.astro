---
// Shared body for the 3 service pages (/catalog/, /lifestyle/, /video/).
// Each page file stays thin — just SEO/schema wiring — and passes its own
// service entry plus imagery in here.
import StyleCard from './StyleCard.astro';
import StatsGrid from './StatsGrid.astro';
import BeforeAfter from './BeforeAfter.astro';
import Carousel from './Carousel.astro';
import { site } from '../data/site.js';

const { service, beforeImage, afterImage, galleryItems } = Astro.props;
---

<section class="hero container">
  <div class="hero-grid">
    <div>
      <p class="eyebrow">VISUAILS Service</p>
      <h1>{service.metaName}</h1>
      <p style="font-size:1.1rem;">{service.tagline}</p>
      <p>{service.shortDescription}</p>
      <div class="hero-actions">
        <a href="/test-sample/" class="btn btn-primary">Start a Test Sample — €0.99</a>
        <a href={site.whatsapp.link} target="_blank" rel="noopener" class="btn btn-whatsapp">Chat with Us</a>
      </div>
    </div>
    <div class="card" style="padding:0; overflow:hidden;">
      <img src={service.heroImage} alt={service.heroImageAlt} width="600" height="450" />
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">How It Works</p>
      <h2>Three Steps, One Photo</h2>
    </div>
    <div class="grid grid-3">
      {service.howItWorks.map((step, i) => (
        <div class="card step-card">
          <div class="step-number">{i + 1}</div>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Styles</p>
      <h2>Pick the Style That Fits Your Brand</h2>
    </div>
    <div class="grid grid-3">
      {service.styles.map((style) => (
        <StyleCard style={style} serviceName={service.name} />
      ))}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <StatsGrid />
  </div>
</section>

<section class="section">
  <div class="container">
    <BeforeAfter
      beforeImage={beforeImage}
      beforeAlt={`Raw product photo before VISUAILS ${service.name} transformation`}
      afterImage={afterImage}
      afterAlt={`Finished VISUAILS ${service.name} visual after transformation`}
    />
  </div>
</section>

{galleryItems && (
  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Examples</p>
        <h2>{service.name} in Practice</h2>
      </div>
      <Carousel items={galleryItems} />
    </div>
  </section>
)}

<section class="section">
  <div class="container">
    <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 40px; align-items:center;">
      <div>
        <p class="eyebrow">Refined to Perfection</p>
        <h2>Not Just AI. <span class="accent">Human Reviewed.</span></h2>
        <p>Unlike raw AI tools, every VISUAILS visual is generated, selected, and manually checked before it reaches you — so what you publish is consistent, accurate, and ready to use.</p>
      </div>
      <div class="pill-list">
        <span class="pill">100% Human-reviewed</span>
        <span class="pill">No AI artifacts</span>
        <span class="pill">Consistent every batch</span>
        <span class="pill">Delivered in ~24 hours</span>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">FAQ</p>
      <h2>{service.name} Questions</h2>
    </div>
    <div style="max-width:760px; margin:0 auto;">
      {service.faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-band">
      <p class="eyebrow" style="margin-bottom:8px;">Let's Grow Together</p>
      <h2>Ready to See Your {service.name}?</h2>
      <p>Start with a €0.99 sample, or message us directly.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href="/test-sample/" class="btn btn-primary">Start a Test Sample</a>
        <a href={site.whatsapp.link} target="_blank" rel="noopener" class="btn btn-whatsapp">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
